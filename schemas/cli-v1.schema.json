{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LordCasser/ASC/schemas/cli-v1.schema.json",
  "title": "rasc CLI JSON contract (schema_version 1)",
  "description": "The frozen shape of every successful command envelope and error object. Golden bytes for the A01-owned objects live in schemas/goldens/; getclass/manifest data shapes are declared here and frozen as goldens when A07/A08 land them. Keys serialize in the documented order; values are UTF-8 with control characters escaped and no NaN/Infinity numbers.",
  "type": "object",
  "required": ["schema_version", "operation", "artifact_id", "data", "diagnostics"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation": {
      "enum": ["findrefs", "class_relations", "classes", "getclass", "manifest", "dexes"]
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the whole input bytes, lowercase hex."
    },
    "data": { "description": "The payload shape is selected by operation below; empty array results are successful." },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": { "const": "findrefs" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      }
    },
    {
      "properties": {
        "operation": { "const": "class_relations" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/class_relation" } }
      }
    },
    {
      "properties": {
        "operation": { "const": "classes" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/class" } }
      }
    },
    {
      "properties": {
        "operation": { "const": "dexes" },
        "data": { "type": "array", "items": { "$ref": "#/$defs/dex_entry" } }
      }
    },
    {
      "properties": {
        "operation": { "const": "getclass" },
        "data": {
          "type": "object",
          "required": ["class", "source", "metadata"],
          "properties": {
            "class": { "$ref": "#/$defs/class" },
            "source": { "type": "string", "description": "UTF-8, LF endings, exactly one trailing LF." },
            "metadata": { "$ref": "#/$defs/source_metadata" }
          }
        }
      }
    },
    {
      "properties": {
        "operation": { "const": "manifest" },
        "data": {
          "type": "object",
          "required": ["xml", "document"],
          "properties": {
            "xml": { "type": "string", "description": "Complete rendered XML; never null when the command succeeded." },
            "document": { "$ref": "#/$defs/document" }
          }
        }
      }
    }
  ],
  "$defs": {
    "class_relation": {
      "type": "object",
      "required": ["class", "kind", "target_id", "target"],
      "additionalProperties": false,
      "description": "One directly declared superclass or interface edge. The target_id always identifies a type in the source class's DEX; no transitive or inherited edges are inferred.",
      "properties": {
        "class": { "$ref": "#/$defs/class" },
        "kind": { "enum": ["extends", "implements"] },
        "target_id": { "$ref": "#/$defs/target_id" },
        "target": { "$ref": "#/$defs/dex_text" }
      }
    },
    "source_metadata": {
      "type": "object",
      "required": ["class", "annotations", "fields", "methods"],
      "description": "Typed SourceMetadata projection; absent optional data is null, never a fabricated default. Raw typed bits (float/double/long words) are fixed-width hex strings.",
      "properties": {
        "class": { "$ref": "#/$defs/source_class_metadata" },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation_entry" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field_metadata" } },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/method_metadata" } }
      }
    },
    "source_class_metadata": {
      "type": "object",
      "required": ["access_flags", "super_class", "interfaces", "source_file", "generic_signature", "enclosing", "inner_classes"],
      "properties": {
        "access_flags": { "type": "integer", "minimum": 0 },
        "super_class": { "$ref": "#/$defs/dex_text_or_null" },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/dex_text" } },
        "source_file": { "$ref": "#/$defs/dex_text_or_null" },
        "generic_signature": { "$ref": "#/$defs/dex_text_or_null" },
        "enclosing": {
          "oneOf": [
            { "$ref": "#/$defs/enclosing_record" },
            { "type": "null" }
          ]
        },
        "inner_classes": { "type": "array", "items": { "$ref": "#/$defs/inner_class_record" } }
      }
    },
    "dex_text_or_null": {
      "oneOf": [
        { "$ref": "#/$defs/dex_text" },
        { "type": "null" }
      ]
    },
    "enclosing_record": {
      "type": "object",
      "required": ["outer_class", "enclosing_method"],
      "properties": {
        "outer_class": { "$ref": "#/$defs/dex_text_or_null" },
        "enclosing_method": {
          "description": "Positional triple as stored: rendered text, name, prototype.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "$ref": "#/$defs/dex_text" },
                { "$ref": "#/$defs/dex_text" },
                { "$ref": "#/$defs/prototype" }
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "inner_class_record": {
      "type": "object",
      "required": ["inner_class", "outer_class", "inner_name", "access_flags"],
      "properties": {
        "inner_class": { "$ref": "#/$defs/dex_text" },
        "outer_class": { "$ref": "#/$defs/dex_text_or_null" },
        "inner_name": { "$ref": "#/$defs/dex_text_or_null" },
        "access_flags": { "type": "integer", "minimum": 0 }
      }
    },
    "annotation_entry": {
      "type": "object",
      "required": ["target", "annotation"],
      "properties": {
        "target": { "$ref": "#/$defs/annotation_target" },
        "annotation": { "$ref": "#/$defs/annotation_record" }
      }
    },
    "annotation_target": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "enum": ["class", "field", "method", "parameter"] },
        "index": { "type": "integer", "minimum": 0 },
        "method_index": { "type": "integer", "minimum": 0 },
        "parameter_index": { "type": "integer", "minimum": 0 }
      }
    },
    "annotation_record": {
      "type": "object",
      "required": ["visibility", "type_descriptor", "items", "rendered"],
      "properties": {
        "visibility": { "enum": ["build", "runtime", "system"] },
        "type_descriptor": { "$ref": "#/$defs/dex_text" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": { "$ref": "#/$defs/dex_text" },
              "value": { "$ref": "#/$defs/encoded_value" }
            }
          }
        },
        "rendered": { "type": "string", "description": "Lossless backend rendering of the element list." }
      }
    },
    "encoded_value": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": ["null", "boolean", "byte", "short", "int", "long", "char", "float", "double",
            "string", "type", "field", "method", "enum", "array", "annotation"]
        },
        "value": {},
        "bits": { "type": "string", "pattern": "^0x[0-9a-f]+$", "description": "Fixed-width raw bits for float (8 hex digits) and double (16 hex digits); value is absent then." }
      }
    },
    "field_metadata": {
      "type": "object",
      "required": ["name", "field_type", "access_flags", "generic_signature", "initial_value"],
      "properties": {
        "name": { "$ref": "#/$defs/dex_text" },
        "field_type": { "$ref": "#/$defs/dex_text" },
        "access_flags": { "type": "integer", "minimum": 0 },
        "generic_signature": { "$ref": "#/$defs/dex_text_or_null" },
        "initial_value": {
          "oneOf": [
            { "$ref": "#/$defs/encoded_value" },
            { "type": "null" }
          ]
        }
      }
    },
    "method_metadata": {
      "type": "object",
      "required": ["name", "prototype", "access_flags", "generic_signature", "throws", "annotations", "parameter_signatures", "debug"],
      "properties": {
        "name": { "$ref": "#/$defs/dex_text" },
        "prototype": { "$ref": "#/$defs/prototype" },
        "access_flags": { "type": "integer", "minimum": 0 },
        "generic_signature": { "$ref": "#/$defs/dex_text_or_null" },
        "throws": { "type": "array", "items": { "$ref": "#/$defs/dex_text" } },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation_entry" } },
        "parameter_signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/dex_text_or_null" }
        },
        "debug": {
          "oneOf": [
            { "$ref": "#/$defs/debug_info" },
            { "type": "null" }
          ]
        }
      }
    },
    "debug_info": {
      "type": "object",
      "required": ["parameter_names", "locals", "lines"],
      "properties": {
        "parameter_names": { "type": "array", "items": { "$ref": "#/$defs/dex_text_or_null" } },
        "locals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "start_code_unit", "end_code_unit", "slot"],
            "properties": {
              "name": { "$ref": "#/$defs/dex_text" },
              "start_code_unit": { "type": "integer", "minimum": 0 },
              "end_code_unit": { "type": "integer", "minimum": 0 },
              "slot": { "type": "integer", "minimum": 0, "maximum": 65535 }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code_unit", "line"],
            "properties": {
              "code_unit": { "type": "integer", "minimum": 0 },
              "line": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["declaration", "prolog", "root", "epilog", "metadata"],
      "description": "Ordered manifest document: nodes, attributes with namespace decomposition, namespace scope events, typed raw values and string styles.",
      "properties": {
        "declaration": {
          "oneOf": [
            {
              "type": "object",
              "required": ["version", "encoding", "standalone"],
              "properties": {
                "version": { "type": "string" },
                "encoding": { "type": ["string", "null"] },
                "standalone": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "prolog": { "type": "array", "items": { "$ref": "#/$defs/misc_node" } },
        "root": { "$ref": "#/$defs/element_node" },
        "epilog": { "type": "array", "items": { "$ref": "#/$defs/misc_node" } },
        "metadata": { "$ref": "#/$defs/document_metadata" }
      }
    },
    "misc_node": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "comment", "pi"] },
        "text": { "$ref": "#/$defs/text_payload" },
        "target": { "type": "string" },
        "data": { "type": "string" }
      }
    },
    "element_node": {
      "type": "object",
      "required": ["namespace", "prefix", "local_name", "attributes", "children", "metadata"],
      "properties": {
        "namespace": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "local_name": { "type": "string" },
        "attributes": { "type": "array", "items": { "$ref": "#/$defs/attribute_node" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/child_node" } },
        "metadata": { "$ref": "#/$defs/element_metadata" }
      }
    },
    "child_node": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "const": "element" } },
          "allOf": [ { "$ref": "#/$defs/element_node" } ]
        },
        {
          "type": "object",
          "properties": {
            "kind": { "enum": ["text", "comment", "pi", "cdata"] },
            "text": { "$ref": "#/$defs/text_payload" },
            "target": { "type": "string" },
            "data": { "type": "string" }
          }
        }
      ]
    },
    "text_payload": {
      "description": "Comment text is a plain string; text/CDATA content is a lossless dex_text object.",
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/dex_text" },
        { "type": "null" }
      ]
    },
    "attribute_node": {
      "type": "object",
      "required": ["namespace", "prefix", "local_name", "value"],
      "properties": {
        "namespace": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "local_name": { "type": "string" },
        "value": { "$ref": "#/$defs/manifest_value" }
      }
    },
    "manifest_value": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "$ref": "#/$defs/dex_text" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "type_byte", "data", "raw_string"],
          "properties": {
            "kind": { "const": "typed" },
            "type_byte": { "type": "integer", "minimum": 0, "maximum": 255 },
            "data": { "type": "string", "pattern": "^0x[0-9a-f]{8}$", "description": "Raw 32-bit data word as fixed-width hex." },
            "raw_string": { "$ref": "#/$defs/dex_text_or_null" }
          }
        }
      ]
    },
    "element_metadata": {
      "type": "object",
      "required": ["line_number", "comment", "namespace_events"],
      "properties": {
        "line_number": { "type": ["integer", "null"], "minimum": 0 },
        "comment": { "type": ["string", "null"] },
        "namespace_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "prefix", "uri"],
            "properties": {
              "event": { "enum": ["start", "end"] },
              "prefix": { "type": "string" },
              "uri": { "type": "string" }
            }
          }
        }
      }
    },
    "document_metadata": {
      "type": "object",
      "required": ["source", "string_styles", "resource_map"],
      "properties": {
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "utf8_pool", "string_count"],
              "properties": {
                "kind": { "const": "binary-axml" },
                "utf8_pool": { "type": "boolean" },
                "string_count": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "plain-xml" } }
            },
            { "type": "null" }
          ]
        },
        "string_styles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["string_index", "spans"],
            "properties": {
              "string_index": { "type": "integer", "minimum": 0 },
              "spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name_index", "first_char", "last_char"],
                  "properties": {
                    "name_index": { "type": "integer", "minimum": 0 },
                    "first_char": { "type": "integer", "minimum": 0 },
                    "last_char": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        },
        "resource_map": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "artifact_id_object_base": {
      "type": "object",
      "required": ["artifact_id", "entry_ordinal", "logical_ordinal"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "entry_ordinal": { "type": "integer", "minimum": 0 },
        "logical_ordinal": { "type": "integer", "minimum": 0 }
      }
    },
    "class_id": {
      "allOf": [
        { "$ref": "#/$defs/artifact_id_object_base" },
        {
          "type": "object",
          "required": ["class_def_idx"],
          "properties": { "class_def_idx": { "type": "integer", "minimum": 0 } }
        }
      ]
    },
    "method_id": {
      "allOf": [
        { "$ref": "#/$defs/artifact_id_object_base" },
        {
          "type": "object",
          "required": ["method_idx"],
          "properties": { "method_idx": { "type": "integer", "minimum": 0 } }
        }
      ]
    },
    "target_id": {
      "allOf": [
        { "$ref": "#/$defs/artifact_id_object_base" },
        {
          "type": "object",
          "required": ["index"],
          "properties": { "index": { "type": "integer", "minimum": 0 } }
        }
      ]
    },
    "dex_id": { "$ref": "#/$defs/artifact_id_object_base" },
    "dex_text": {
      "type": "object",
      "required": ["text", "utf16"],
      "properties": {
        "text": {
          "type": ["string", "null"],
          "description": "null exactly when the UTF-16 units are not valid Unicode (unpaired surrogate)."
        },
        "utf16": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 65535 } }
      }
    },
    "prototype": {
      "type": "object",
      "required": ["parameters", "return_type"],
      "properties": {
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/dex_text" } },
        "return_type": { "$ref": "#/$defs/dex_text" }
      }
    },
    "dex_entry": {
      "type": "object",
      "required": ["id", "raw_entry_name", "display_name", "logical_name", "version", "header_offset"],
      "properties": {
        "id": { "$ref": "#/$defs/dex_id" },
        "raw_entry_name": { "type": "string" },
        "display_name": { "$ref": "#/$defs/dex_text" },
        "logical_name": { "$ref": "#/$defs/dex_text" },
        "version": { "enum": ["035", "037", "038", "039", "040", "041"] },
        "header_offset": { "type": "integer", "minimum": 0 }
      }
    },
    "reference": {
      "type": "object",
      "required": ["caller", "targets"],
      "properties": {
        "caller": {
          "type": "object",
          "required": ["id", "dex", "owner", "name", "prototype"],
          "properties": {
            "id": { "$ref": "#/$defs/method_id" },
            "dex": { "$ref": "#/$defs/dex_entry" },
            "owner": { "$ref": "#/$defs/dex_text" },
            "name": { "$ref": "#/$defs/dex_text" },
            "prototype": { "$ref": "#/$defs/prototype" }
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "value", "code_unit_offsets"],
            "properties": {
              "id": { "$ref": "#/$defs/target_id" },
              "kind": { "enum": ["string", "type", "field", "method"] },
              "value": {
                "oneOf": [
                  { "$ref": "#/$defs/dex_text" },
                  {
                    "type": "object",
                    "required": ["owner", "name", "field_type"],
                    "properties": {
                      "owner": { "$ref": "#/$defs/dex_text" },
                      "name": { "$ref": "#/$defs/dex_text" },
                      "field_type": { "$ref": "#/$defs/dex_text" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["owner", "name", "prototype"],
                    "properties": {
                      "owner": { "$ref": "#/$defs/dex_text" },
                      "name": { "$ref": "#/$defs/dex_text" },
                      "prototype": { "$ref": "#/$defs/prototype" }
                    }
                  }
                ]
              },
              "code_unit_offsets": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "description": "Ascending, deduplicated 16-bit code units from the insns array start."
              }
            }
          }
        }
      }
    },
    "class": {
      "type": "object",
      "required": ["id", "dex", "descriptor", "java_name", "package", "simple_name"],
      "properties": {
        "id": { "$ref": "#/$defs/class_id" },
        "dex": { "$ref": "#/$defs/dex_entry" },
        "descriptor": { "type": "string", "pattern": "^L.+;$" },
        "java_name": { "$ref": "#/$defs/dex_text" },
        "package": { "$ref": "#/$defs/dex_text" },
        "simple_name": { "$ref": "#/$defs/dex_text" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "stage", "message"],
      "properties": {
        "code": {
          "enum": [
            "dex-checksum-mismatch",
            "dex-signature-mismatch",
            "duplicate-entry-name",
            "duplicate-class-definition",
            "inferred-namespace-binding",
            "decompilation-notice"
          ]
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "stage": { "enum": ["input", "dex", "query", "decompile", "manifest"] },
        "dex": { "$ref": "#/$defs/dex_id" },
        "class": { "$ref": "#/$defs/class_id" },
        "method": { "$ref": "#/$defs/method_id" },
        "offset": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "description": "Human-facing; not machine identity." }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "context", "diagnostics"],
      "properties": {
        "code": {
          "enum": [
            "InvalidQuery",
            "NotFound",
            "MalformedInput",
            "UnsupportedFormat",
            "UnsupportedEncoding",
            "ResourceLimit",
            "Cancelled",
            "IncompleteDecompilation"
          ]
        },
        "context": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "description": "Error objects replace the whole envelope on failure; no success payload is emitted."
    }
  }
}
